{
  "name": "singularityfm-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @singularity/design run check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "docs:check": "node scripts/docsCheck.mjs",
    "pack:check": "node scripts/designSystemPack.mjs",
    "guide:validate": "pnpm run ds validate --exceptions apps/design/validate-exceptions.json \"apps/design/src/**/*\"",
    "build": "pnpm --filter @singularityfm/design-system run build && pnpm --filter @singularity/design run build",
    "gate": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run guide:validate && pnpm run build && pnpm run pack:check",
    "dev": "pnpm --filter @singularity/design run dev",
    "tokens": "tsx packages/design-system/scripts/buildTokens.ts",
    "system": "tsx packages/design-system/scripts/system/build.ts",
    "ds": "tsx packages/design-system/scripts/system/cli.ts",
    "glyphs": "tsx scripts/buildGlyphs.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "3.0.3",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@phosphor-icons/core": "2.1.1",
    "@types/node": "^26.6.6",
    "playwright-core": "1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
