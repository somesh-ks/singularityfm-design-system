---
/**
 * @deprecated Import MenuItem from "@singularityfm/design-system/MenuItem" and pass className (DS-5).
 * This path stays until a breaking release: it renders that React MenuItem, `class` passed on as
 * className and its slot as the row's content, and draws nothing of its own (designSystem.test.ts
 * holds it to that). Outside a React Menu, as in the deprecated Menu.astro, the row is the same
 * button it was, with no script.
 */
import type { HTMLAttributes } from "astro/types";
import MenuItem from "./MenuItem.tsx";
import type { MenuItemTone } from "./menu";

type Props = Omit<HTMLAttributes<"button">, "class" | "role"> & {
  class?: string;
  tone?: MenuItemTone;
};

const { class: className, ...props } = Astro.props;
---

<MenuItem {...props} className={className}><slot /></MenuItem>
