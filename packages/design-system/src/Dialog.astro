---
/**
 * @deprecated Import Dialog from "@singularityfm/design-system/Dialog" and pass className (DS-5).
 * This path stays until a breaking release: it renders that React Dialog, `class` passed on as
 * className, its attributes on the dialog, its slot as children and its `after` slot as `after`, and
 * draws nothing of its own (designSystem.test.ts holds it to that).
 */
import type { HTMLAttributes } from "astro/types";
import Dialog from "./Dialog.tsx";

type Props = { form?: Record<string, unknown> } & Omit<HTMLAttributes<"dialog">, "form">;

const { class: className, ...props } = Astro.props;
---

<Dialog {...props} className={className}><slot /><slot name="after" slot="after" /></Dialog>
