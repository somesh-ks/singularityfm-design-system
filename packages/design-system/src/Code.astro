---
/**
 * @deprecated Import Code from "@singularityfm/design-system/Code", pass className and draw it with
 * client:load (DS-5, DS-7). This path stays until a breaking release: it renders that React Code,
 * `class` passed on as className, hydrated where it is drawn so its button still copies, and draws
 * nothing of its own (designSystem.test.ts holds it to that).
 */
import type { ComponentProps } from "react";
import Code from "./Code.tsx";

type Props = Omit<ComponentProps<typeof Code>, "className"> & { class?: string };

const { class: className, ...props } = Astro.props;
---

<Code {...props} className={className} client:load />
