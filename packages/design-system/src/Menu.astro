---
/**
 * @deprecated Import Menu from "@singularityfm/design-system/Menu" and pass className (DS-5, DS-8).
 * This path stays until a breaking release: it renders that React Menu, `class` passed on as className
 * and its slot as the rows, and draws nothing of its own (designSystem.test.ts holds it to that). The
 * Menu is a native popover and takes no client directive.
 */
import Menu from "./Menu.tsx";

type Props = { id: string; title: string; subtitle?: string; class?: string };

const { class: className, ...props } = Astro.props;
---

<Menu {...props} className={className}><slot /></Menu>
