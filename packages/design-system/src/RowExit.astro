---
/**
 * @deprecated Import RowExit from "@singularityfm/design-system/RowExit" and pass className (DS-5).
 * This path stays until a breaking release: it renders that React RowExit, `class` passed on as
 * className, its other attributes on the row and its slot as children, and draws nothing of its own
 * (designSystem.test.ts holds it to that). Its attributes stay as open as the Astro row's were: a
 * `style` string reaches the .tsx, which turns it into the object React needs.
 */
import RowExit from "./RowExit.tsx";

type Props = Record<string, unknown> & { class?: string };

const { class: className, ...props } = Astro.props;
---

<RowExit {...props} className={className}><slot /></RowExit>
