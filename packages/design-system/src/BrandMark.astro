---
/**
 * @deprecated Import BrandMark from "@singularityfm/design-system/BrandMark" and pass className
 * (DS-5). This path stays until a breaking release: it renders that React BrandMark, `class` passed
 * on as className, and draws nothing of its own (designSystem.test.ts holds it to that).
 */
import type { ComponentProps } from "react";
import BrandMark from "./BrandMark.tsx";

type Props = Omit<ComponentProps<typeof BrandMark>, "className"> & { class?: string };

const { class: className, ...props } = Astro.props;
---

<BrandMark {...props} className={className} />
