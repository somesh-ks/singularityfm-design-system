---
/**
 * @deprecated Import Icon from "@singularityfm/design-system/Icon" and pass className (DS-5). This
 * path stays until a breaking release: it renders that React Icon, `class` passed on as className,
 * and draws nothing of its own (designSystem.test.ts holds it to that).
 */
import type { ComponentProps } from "react";
import Icon from "./Icon.tsx";

type Props = Omit<ComponentProps<typeof Icon>, "className"> & { class?: string };

const { class: className, ...props } = Astro.props;
---

<Icon {...props} className={className} />
