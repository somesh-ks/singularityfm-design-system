---
/**
 * @deprecated Import Slider from "@singularityfm/design-system/Slider", pass className and draw it
 * with client:load (DS-5, DS-7). This path stays until a breaking release: it renders that React
 * Slider, `class` passed on as className and `value` as defaultValue (a page cannot hold a value React
 * controls), hydrated where it is drawn so it still answers a drag, and draws nothing of its own
 * (designSystem.test.ts holds it to that). The Slider keeps --range-fill itself.
 */
import type { HTMLAttributes } from "astro/types";
import Slider from "./Slider.tsx";

type Props = Omit<HTMLAttributes<"input">, "class" | "type"> & {
  class?: string;
  hue?: boolean;
  wavy?: boolean;
};

const { class: className, value: defaultValue, ...props } = Astro.props;
---

<Slider defaultValue={defaultValue} {...props} className={className} client:load />
