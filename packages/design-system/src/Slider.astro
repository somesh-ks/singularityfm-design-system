---
/**
 * @deprecated Import Slider from "@singularityfm/design-system/Slider" and pass className (DS-5,
 * DS-8). This path stays until a breaking release: it renders that React Slider, the same native
 * range, `class` passed on as className and `value` as defaultValue (React's starting state), and
 * draws nothing of its own (designSystem.test.ts holds it to that).
 */
import type { HTMLAttributes } from "astro/types";
import Slider from "./Slider.tsx";

type Props = Omit<HTMLAttributes<"input">, "class" | "type"> & {
  class?: string;
  hue?: boolean;
  wavy?: boolean;
};

const { class: className, value: defaultValue, ...props } = Astro.props;
---

<Slider defaultValue={defaultValue} {...props} className={className} />
