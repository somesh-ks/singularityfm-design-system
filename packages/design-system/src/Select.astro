---
/**
 * @deprecated Import Select from "@singularityfm/design-system/Select", pass className and call
 * installSelectSheet() once in the page's script (DS-5, DS-8). This path stays until a breaking
 * release: it renders that React Select, `class` passed on as className and its slot as the options,
 * draws nothing of its own (designSystem.test.ts holds it to that), and still installs the phone's
 * sheet, as it always did.
 */
import type { HTMLAttributes } from "astro/types";
import Select from "./Select.tsx";
import type { SelectVariant } from "./select.ts";

type Props = Omit<HTMLAttributes<"select">, "class"> & {
  class?: string;
  variant?: SelectVariant;
  label?: string;
};

const { class: className, ...props } = Astro.props;
---

<Select {...props} className={className}><slot /></Select>

<script>
  import { installSelectSheet } from "./selectSheet.ts";

  installSelectSheet();
</script>
