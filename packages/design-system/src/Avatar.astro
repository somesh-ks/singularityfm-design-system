---
/**
 * @deprecated Import Avatar from "@singularityfm/design-system/Avatar" and pass className (DS-5). This
 * path stays until a breaking release: it renders that React Avatar, `class` passed on as className,
 * and draws nothing of its own (designSystem.test.ts holds it to that). It takes no client directive,
 * so a script still redraws its shape in place; a photo it draws does not fall back to the shape when
 * it fails to load, as this path's never did (DS-7).
 */
import type { ComponentProps } from "react";
import Avatar from "./Avatar.tsx";

type Props = Omit<ComponentProps<typeof Avatar>, "className"> & { class?: string };

const { class: className, ...props } = Astro.props;
---

<Avatar {...props} className={className} />
