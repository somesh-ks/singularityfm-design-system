---
/**
 * @deprecated Import Field from "@singularityfm/design-system/Field" and pass className (DS-5). This
 * path stays until a breaking release: it renders that React Field, `class` passed on as className and
 * `value` as defaultValue (a page cannot hold a value React controls), and draws nothing of its own
 * (designSystem.test.ts holds it to that). Its attributes stay as open as the Astro field's were. It
 * takes no client directive: the Field is a native input, which types and submits unhydrated (DS-8).
 */
import type { HTMLAttributes } from "astro/types";
import Field from "./Field.tsx";

type Props = Omit<HTMLAttributes<"input">, "class"> &
  Pick<HTMLAttributes<"textarea">, "rows" | "cols" | "wrap"> & {
    class?: string;
    multiline?: boolean;
    maxLines?: number;
  };

const { class: className, value: defaultValue, ...props } = Astro.props;
---

<Field defaultValue={defaultValue} {...props} className={className} />
