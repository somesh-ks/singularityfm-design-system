---
/**
 * @deprecated Import Sheet from "@singularityfm/design-system/Sheet" and pass className (DS-5). This
 * path stays until a breaking release: it renders that React Sheet, `class` passed on as className,
 * its attributes on the dialog, its slot as children and its `after` slot as `after`, and draws
 * nothing of its own (designSystem.test.ts holds it to that).
 */
import type { HTMLAttributes } from "astro/types";
import type { ComponentProps } from "react";
import Sheet from "./Sheet.tsx";

type Props = Pick<
  ComponentProps<typeof Sheet>,
  "title" | "titleId" | "close" | "titleData" | "kind"
> &
  Omit<HTMLAttributes<"dialog">, "title">;

const { class: className, ...props } = Astro.props;
---

<Sheet {...props} className={className}><slot /><slot name="after" slot="after" /></Sheet>
