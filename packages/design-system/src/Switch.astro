---
/**
 * @deprecated Import Switch from "@singularityfm/design-system/Switch" and pass className (DS-5,
 * DS-8). This path stays until a breaking release: it renders that React Switch, the same native
 * checkbox, `class` passed on as className and `checked` as defaultChecked (React's starting state),
 * and draws nothing of its own (designSystem.test.ts holds it to that).
 */
import type { HTMLAttributes } from "astro/types";
import Switch from "./Switch.tsx";

type Props = Omit<HTMLAttributes<"input">, "class" | "type" | "role"> & { class?: string };

const { class: className, checked: defaultChecked, ...props } = Astro.props;
---

<Switch defaultChecked={defaultChecked} {...props} className={className} />
