{
  "name": "@singularityfm/design-system",
  "version": "0.2.0",
  "description": "Singularity's design system: React components (Base UI where they have behaviour), stylesheets, tokens, fonts and flags.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somesh-ks/singularityfm-design-system.git",
    "directory": "packages/design-system"
  },
  "type": "module",
  "files": [
    "src",
    "styles",
    "tokens",
    "fonts",
    "flags",
    "scripts",
    "rules",
    "!**/*.test.ts",
    "!**/golden.json",
    "COMPATIBILITY.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./scripts/themeInit.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/buildTokens.ts",
    "test": "vitest run"
  },
  "exports": {
    "./styles/*": "./styles/*",
    "./tokens/*": "./tokens/*",
    "./fonts/*": "./fonts/*",
    "./flags/*": "./flags/*",
    "./scripts/themeInit.js": "./scripts/themeInit.js",
    "./scripts/*": "./scripts/*.ts",
    "./rules": "./rules/index.ts",
    "./rules/biome-config.json": "./rules/biome-config.json",
    "./Button": "./src/Button.tsx",
    "./Button.astro": "./src/Button.tsx",
    "./Badge": "./src/Badge.tsx",
    "./Banner": "./src/Banner.tsx",
    "./Avatar": "./src/Avatar.tsx",
    "./BrandMark": "./src/BrandMark.tsx",
    "./ChapterAside": "./src/ChapterAside.tsx",
    "./Code": "./src/Code.tsx",
    "./Fab": "./src/Fab.tsx",
    "./Field": "./src/Field.tsx",
    "./Flag": "./src/Flag.tsx",
    "./Icon": "./src/Icon.tsx",
    "./IconButton": "./src/IconButton.tsx",
    "./Link": "./src/Link.tsx",
    "./Ripple": "./src/Ripple.tsx",
    "./RowExit": "./src/RowExit.tsx",
    "./SectionTabs": "./src/SectionTabs.tsx",
    "./Slider": "./src/Slider.tsx",
    "./Switch": "./src/Switch.tsx",
    "./*.astro": "./src/*.astro",
    "./*": "./src/*.ts"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "astro": "^7.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
