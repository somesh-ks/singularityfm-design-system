// Raw colour in a stylesheet (rules/index.ts rawColour, for Biome): a hex, or a colour function
// that is not a token's. oklch(from var(--x) l c h) and rgb(var(--accent-rgb)) are the token's;
// rgb(255 0 0 / var(--a)) only takes a channel from one and is a literal red. A feature query
// (@supports) tests a syntax and paints nothing. The token files are left out by the includes in
// biome-config.json.
language css

or {
  CssColor() as $colour where {
    not $colour <: within CssSupportsAtRuleDeclarator(),
    register_diagnostic(span=$colour, message="A raw colour: read a colour token (pnpm run ds token color).", severity="error")
  },
  CssFunction(name=$name, items=$items) as $colour where {
    $name <: r"(?i)(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)",
    not $items <: r"(?is)^\s*from\s+(?:var\(|currentcolor\b|[a-z]+\(\s*from\s).*",
    not $items <: r"(?is)^(?:\s|,|/|var\([^()]*(?:\([^()]*\)[^()]*)*\))*$",
    not $colour <: within CssSupportsAtRuleDeclarator(),
    register_diagnostic(span=$colour, message="A raw colour: read a colour token (pnpm run ds token color).", severity="error")
  }
}
