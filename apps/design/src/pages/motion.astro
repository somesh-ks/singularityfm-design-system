---
import Icon from "@singularity/design-system/Icon";
import IconButton from "@singularity/design-system/IconButton";
import SearchField from "@singularity/design-system/SearchField";
import PageHead from "../components/PageHead.astro";
import Shell from "../layouts/Shell.astro";
import { primitive } from "../lib/guide";

const pick = (tokens: ReturnType<typeof primitive.get>) => tokens ?? [];
const durations = pick(primitive.get("duration"));
const eases = pick(primitive.get("ease"));
const interaction = [
  ...pick(primitive.get("spring")),
  ...pick(primitive.get("scale")),
  ...pick(primitive.get("distance")),
  ...pick(primitive.get("state")),
  ...pick(primitive.get("opacity")),
  ...pick(primitive.get("blur")),
];
---

<Shell title="Motion" current="/motion">
  <div class="settings-view guide-page" data-settings data-ready data-motion>
    <PageHead title="Motion" />

    <div class="guide-toolbar">
      <SearchField label="Search motion" placeholder="Search motion" autoComplete="off" data-filter />
    </div>

    <section aria-label="Motion tokens">
      <p class="guide-note">Press a play button to run a token. Durations run on the out curve; curves run on the longest ordinary duration. Nothing in the app moves that the reader did not move.</p>

      <h2 class="section-head text-heading" id="durations">Durations</h2>
      {/* The roles are spelled out: on a phone a row is laid out as a grid (guide.css), which drops a table row's role in WebKit. */}
      <div class="guide-table-wrap">
        <table class="guide-table" role="table">
          <thead class="sr-only"><tr role="row"><th scope="col" role="columnheader">Token</th><th scope="col" role="columnheader">Value</th><th scope="col" role="columnheader">Motion</th><th scope="col" role="columnheader">Run</th></tr></thead>
          <tbody>
            {
              durations.map((token) => (
                <tr role="row" data-filter-item data-name={token.name}>
                  <td role="cell"><code>{token.name}</code></td>
                  <td role="cell">{token.value}</td>
                  <td role="cell" class="guide-motion-cell">
                    <div class="guide-motion">
                      <div class="guide-motion-track" data-run="false" style={`--run-duration: var(${token.name}); --run-ease: var(--ease-out)`}>
                        <span class="guide-motion-dot" />
                      </div>
                    </div>
                  </td>
                  <td role="cell"><IconButton label={`Run ${token.name}`} data-run-motion><Icon name="play" /></IconButton></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="section-head text-heading" id="curves">Curves</h2>
      <div class="guide-table-wrap">
        <table class="guide-table" role="table">
          <thead class="sr-only"><tr role="row"><th scope="col" role="columnheader">Token</th><th scope="col" role="columnheader">Motion</th><th scope="col" role="columnheader">Run</th></tr></thead>
          <tbody>
            {
              eases.map((token) => (
                <tr role="row" data-filter-item data-name={token.name}>
                  <td role="cell"><code>{token.name}</code></td>
                  <td role="cell" class="guide-motion-cell">
                    <div class="guide-motion">
                      <div class="guide-motion-track" data-run="false" style={`--run-duration: var(--duration-drawer-full); --run-ease: var(${token.name})`}>
                        <span class="guide-motion-dot" />
                      </div>
                    </div>
                  </td>
                  <td role="cell"><IconButton label={`Run ${token.name}`} data-run-motion><Icon name="play" /></IconButton></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="section-head text-heading" id="states">Press, hover and enter</h2>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <thead class="sr-only"><tr><th scope="col">Token</th><th scope="col">Value</th><th scope="col">Use</th></tr></thead>
          <tbody>
            {
              interaction.map((token) => (
                <tr data-filter-item data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td>{token.value}</td>
                  <td>{token.description ?? ""}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>


    <p class="guide-note" hidden data-filter-empty>Nothing matches. Try <code>duration</code>, <code>ease</code> or <code>spring</code>.</p>
  </div>
</Shell>
<script>
  import "../scripts/filter";
  import "../scripts/motion";
</script>
