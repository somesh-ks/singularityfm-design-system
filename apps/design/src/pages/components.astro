---
import GuideTile from "../components/GuideTile.astro";
import PageHead from "../components/PageHead.astro";
import Shell from "../layouts/Shell.astro";
import { COMPONENT_GROUPS } from "../lib/sections";
---

<Shell title="Components" current="/components">
  <div class="settings-view guide-page" data-settings data-ready>
    <PageHead title="Components" />
    <p class="guide-lead">Every component the library ships, grouped by what it does for a person. Each page has a live preview with its states, the code, when to use it and its props.</p>
    {COMPONENT_GROUPS.map((group) => (
      <section aria-labelledby={`group-${group.label.toLowerCase()}`}>
        <h2 class="section-head text-heading" id={`group-${group.label.toLowerCase()}`}>{group.label}</h2>
        <p class="guide-note">{group.note}</p>
        <div class="guide-tiles">
          {group.pages.map((page) => <GuideTile page={page} art="components" />)}
        </div>
      </section>
    ))}
  </div>
</Shell>
