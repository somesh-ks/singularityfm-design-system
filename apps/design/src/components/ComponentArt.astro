---
import Avatar from "@singularity/design-system/Avatar.astro";
import Badge from "@singularity/design-system/Badge";
import Banner from "@singularity/design-system/Banner";
import BrandMark from "@singularity/design-system/BrandMark";
import Button from "@singularity/design-system/Button";
import { codeSnippetHtml } from "@singularity/design-system/code";
import "@singularity/design-system/styles/code.css";
import Fab from "@singularity/design-system/Fab";
import Field from "@singularity/design-system/Field";
import Flag from "@singularity/design-system/Flag";
import Icon from "@singularity/design-system/Icon";
import IconButton from "@singularity/design-system/IconButton";
import MenuItem from "@singularity/design-system/MenuItem.astro";
import { menuBodyClass } from "@singularity/design-system/menu";
import Select from "@singularity/design-system/Select.astro";
import SheetHeader from "@singularity/design-system/SheetHeader";
import Slider from "@singularity/design-system/Slider";
import Switch from "@singularity/design-system/Switch";
import { SAMPLE } from "../lib/components";

/**
 * A component's picture on its card in the index: the component itself in its default state, drawn
 * by the library and not touched (inert, no script). Where the library has nothing to draw (the
 * Wheel, the Drawer, the Glow, the lists) the picture is made of tokens, plainly. The picture sits
 * inside a link, so nothing here may be a link: the Link's picture is its words, drawn plainly.
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span class="guide-live" inert>
  {slug === "button" && <Button variant="filled">{SAMPLE.label}</Button>}
  {
    slug === "icon-button" && (
      <span class="guide-live-row">
        <IconButton label={SAMPLE.label}><Icon name={SAMPLE.glyph} /></IconButton>
        <IconButton label={SAMPLE.label} variant="tonal"><Icon name={SAMPLE.glyph} /></IconButton>
      </span>
    )
  }
  {slug === "fab" && <Fab icon="plus" label={SAMPLE.label}>{SAMPLE.label}</Fab>}
  {slug === "link" && <span class="guide-live-link">{SAMPLE.label}</span>}
  {
    slug === "menu" && (
      <span class:list={[menuBodyClass(), "guide-live-menu"]}>
        <MenuItem><Icon name="share" /> {SAMPLE.menu.items[0]}</MenuItem>
        <MenuItem><Icon name="download" /> {SAMPLE.menu.items[1]}</MenuItem>
      </span>
    )
  }
  {slug === "field" && <Field placeholder={SAMPLE.label} aria-label={SAMPLE.label} tabIndex={-1} />}
  {slug === "switch" && <Switch defaultChecked aria-label={SAMPLE.label} tabIndex={-1} />}
  {
    slug === "slider" && (
      <span class="guide-live-slider">
        <Slider
          min="0"
          max="100"
          defaultValue="40"
          style="--range-fill: 40%"
          aria-label={SAMPLE.label}
          tabIndex={-1}
        />
      </span>
    )
  }
  {
    slug === "select" && (
      <Select variant="outlined" label={SAMPLE.label} tabindex="-1">
        <option>{SAMPLE.select[0]}</option>
      </Select>
    )
  }
  {
    slug === "wheel" && (
      <span class="guide-live-wheel">
        <span>7</span><span>8</span><b>9</b><span>10</span><span>11</span>
      </span>
    )
  }
  {
    slug === "section-tabs" && (
      <span class="guide-live-tabs"><b>{SAMPLE.tabs[0]}</b><span>{SAMPLE.tabs[1]}</span><span>{SAMPLE.tabs[2]}</span></span>
    )
  }
  {
    slug === "chapter-aside" && (
      <span class="guide-live-contents"><span>Contents</span><b>{SAMPLE.chapters[0]}</b><span>{SAMPLE.chapters[1]}</span><span>{SAMPLE.chapters[2]}</span></span>
    )
  }
  {
    slug === "row-exit" && (
      <span class="guide-live-rows"><span>{SAMPLE.rows[0]}</span><span>{SAMPLE.rows[1]}</span><i>{SAMPLE.rows[2]}</i></span>
    )
  }
  {
    slug === "dialog" && (
      <span class="guide-live-surface">
        <b>{SAMPLE.dialog.title}</b>
        <span class="guide-live-actions">
          <Button variant="text" size="small">{SAMPLE.dialog.cancel}</Button>
          <Button variant="filled" size="small">{SAMPLE.dialog.confirm}</Button>
        </span>
      </span>
    )
  }
  {
    slug === "sheet" && (
      <span class="guide-live-surface guide-live-side">
        <SheetHeader title={SAMPLE.sheet} titleId="art-sheet-title" close="data-panel-close" />
      </span>
    )
  }
  {
    slug === "drawer" && (
      <span class="guide-live-surface guide-live-side">
        <span class="guide-live-line"></span><span class="guide-live-line"></span><span class="guide-live-line"></span>
      </span>
    )
  }
  {
    slug === "banner" && (
      <span class="guide-live-wide">
        <Banner tone="warning" variant="strip" icon="wifiOff" title={SAMPLE.banner.title} />
      </span>
    )
  }
  {slug === "badge" && <Badge>{SAMPLE.badge}</Badge>}
  {slug === "ripple" && <span class="guide-live-ripple"><Button variant="tonal">{SAMPLE.label}</Button></span>}
  {slug === "glow" && <span class="guide-live-glow"><Icon name="heartOutline" size="lg" /></span>}
  {
    slug === "icon" && (
      <span class="guide-live-row"><Icon name="house" size="lg" /><Icon name="search" size="lg" /><Icon name="settings" size="lg" /></span>
    )
  }
  {slug === "avatar" && <Avatar shape="cookie" size="lg" />}
  {slug === "flag" && <Flag region="SE" />}
  {slug === "brand-mark" && <BrandMark className="guide-live-mark" />}
  {slug === "code" && <Fragment set:html={codeSnippetHtml(SAMPLE.code, { label: SAMPLE.label })} />}
</span>
