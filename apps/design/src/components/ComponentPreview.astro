---
import Avatar from "@singularity/design-system/Avatar";
import Badge from "@singularity/design-system/Badge";
import Banner from "@singularity/design-system/Banner";
import BrandMark from "@singularity/design-system/BrandMark";
import Button from "@singularity/design-system/Button";
import Chip from "@singularity/design-system/Chip";
import ChipGroup from "@singularity/design-system/ChipGroup";
import Code from "@singularity/design-system/Code";
import Dialog from "@singularity/design-system/Dialog";
import DialogActions from "@singularity/design-system/DialogActions";
import DialogTitle from "@singularity/design-system/DialogTitle";
import Fab from "@singularity/design-system/Fab";
import Field from "@singularity/design-system/Field";
import Flag from "@singularity/design-system/Flag";
import Icon from "@singularity/design-system/Icon";
import IconButton from "@singularity/design-system/IconButton";
import type { IconName } from "@singularity/design-system/icons";
import Link from "@singularity/design-system/Link";
import Menu from "@singularity/design-system/Menu";
import MenuItem from "@singularity/design-system/MenuItem";
import PlayChip from "@singularity/design-system/PlayChip";
import type { PlayChipState } from "@singularity/design-system/playChip";
import Ripple from "@singularity/design-system/Ripple";
import RowExit from "@singularity/design-system/RowExit";
import SearchField from "@singularity/design-system/SearchField";
import SectionTabs from "@singularity/design-system/SectionTabs";
import SegmentedChoice from "@singularity/design-system/SegmentedChoice";
import SegmentedNav from "@singularity/design-system/SegmentedNav";
import Select from "@singularity/design-system/Select";
import Sheet from "@singularity/design-system/Sheet";
import Slider from "@singularity/design-system/Slider";
import Switch from "@singularity/design-system/Switch";
import type { CSSProperties } from "react";
import {
  BANNER_ICON,
  FLAG_CHOICES,
  regionEmoji,
  SAMPLE,
  SEGMENT_GLYPHS,
  type State,
  sampleSlug,
} from "../lib/components";

/**
 * One state of a component page's controls, drawn by the component itself. The page renders every
 * state and componentPage.ts shows the one the controls name, so the preview is the library's own
 * markup and ships no framework. An id keeps the overlays' ids unique across the states.
 */
interface Props {
  slug: string;
  state: State;
  id: string;
}

const { slug, state, id } = Astro.props;
const on = (name: string): boolean => state[name] === "on";
const menuIcons: IconName[] = ["share", "queueAdd", "download", "check", "openInNew"];
const FLAG_NAMES = Object.fromEntries(FLAG_CHOICES);
const tone = (state.tone ?? "warning") as keyof typeof BANNER_ICON;
---

{
  slug === "button" && (
    <Button
      variant={state.variant === "danger" ? "text" : (state.variant as "filled" | "tonal" | "text")}
      tone={state.variant === "danger" ? "danger" : undefined}
      size={state.size === "small" ? "small" : undefined}
      href={state.element === "link" ? "#" : undefined}
      disabled={state.element === "link" ? undefined : on("disabled")}
    >
      {state.variant === "danger" ? SAMPLE.danger : SAMPLE.label}
    </Button>
  )
}

{
  slug === "icon-button" && (
    <IconButton
      label={SAMPLE.label}
      variant={state.variant === "tonal" ? "tonal" : undefined}
      href={state.element === "link" ? "#" : undefined}
      disabled={state.element === "link" ? undefined : on("disabled")}
    >
      <Icon name={SAMPLE.glyph} />
    </IconButton>
  )
}

{
  slug === "fab" && (
    <Fab icon="plus" label={SAMPLE.label} href="#" data-folded={on("folded") ? "" : undefined}>
      {SAMPLE.label}
    </Fab>
  )
}

{
  slug === "link" &&
    (state.variant === "source" ? (
      <Link variant="source" href="#">{SAMPLE.source}</Link>
    ) : (
      <p class="guide-prose">
        {SAMPLE.sentence[0]} <Link href="#">{SAMPLE.label}</Link> {SAMPLE.sentence[1]}
      </p>
    ))
}

{
  slug === "play-chip" && (
    <div class="card-group">
      <PlayChip
        label={SAMPLE.duration}
        state={state.state as PlayChipState}
        data-playing={on("playing") ? "true" : "false"}
        aria-label={SAMPLE.label}
      />
    </div>
  )
}

{
  slug === "menu" && (
    <>
      <Button variant="tonal" popoverTarget={`${id}-menu`}>
        {SAMPLE.menu.trigger}
      </Button>
      <Menu id={`${id}-menu`} title={SAMPLE.menu.title} subtitle={on("subtitle") ? SAMPLE.menu.subtitle : undefined}>
        {SAMPLE.menu.items.slice(0, Number(state.items)).map((label, n) => (
          <MenuItem>
            <Icon name={menuIcons[n] ?? "check"} /> {label}
          </MenuItem>
        ))}
        {
          on("danger") && (
            <MenuItem tone="danger">
              <Icon name="trash" /> {SAMPLE.danger}
            </MenuItem>
          )
        }
      </Menu>
    </>
  )
}

{
  slug === "field" && (
    <Field
      multiline={state.lines === "multi"}
      defaultValue={on("filled") ? SAMPLE.value : undefined}
      placeholder={on("filled") ? undefined : SAMPLE.label}
      aria-label={SAMPLE.label}
      disabled={on("disabled")}
    />
  )
}

{
  slug === "switch" && (
    <Switch
      defaultChecked={state.state === "on"}
      data-mixed={state.state === "mixed" ? "" : undefined}
      aria-label={SAMPLE.label}
      disabled={on("disabled")}
    />
  )
}

{
  slug === "slider" && (
    <Slider
      hue={state.variant === "hue"}
      wavy={state.variant === "wavy"}
      min="0"
      max="100"
      defaultValue="40"
      aria-label={SAMPLE.label}
      disabled={on("disabled")}
    />
  )
}

{
  slug === "chip" && (
    <ChipGroup className="card-group" aria-label={SAMPLE.label} scroll={on("scroll")} disabled={on("disabled")}>
      {SAMPLE.select.map((option, n) => (
        <Chip name={`${id}-chip`} value={String(n + 1)} defaultChecked={n === 0 && on("ticked")}>
          {option}
        </Chip>
      ))}
    </ChipGroup>
  )
}

{
  slug === "segmented-choice" && (
    <SegmentedChoice
      name={`${id}-choice`}
      aria-label={SAMPLE.label}
      defaultValue="1"
      disabled={on("disabled")}
      options={SAMPLE.segments.slice(0, Number(state.count)).map((label, n) => ({ value: String(n + 1), label }))}
    />
  )
}

{
  slug === "search-field" && (
    <SearchField
      label={SAMPLE.search}
      name="q"
      placeholder={SAMPLE.search}
      defaultValue={on("filled") ? SAMPLE.value : undefined}
    />
  )
}

{
  slug === "select" && (
    <Select variant={state.variant as "outlined" | "tonal"} label={SAMPLE.label} disabled={on("disabled")}>
      {SAMPLE.select.map((option, n) => <option value={n + 1}>{option}</option>)}
    </Select>
  )
}

{
  slug === "segmented-nav" && (
    <SegmentedNav
      aria-label={SAMPLE.label}
      compact={state.size === "compact"}
      style={{ "--segmented-nav-bg": "var(--color-surface-overlay)" } as CSSProperties}
      tabs={SAMPLE.segments.slice(0, Number(state.count)).map((label, n) => ({
        value: String(n + 1),
        label,
        icon: state.size === "compact" ? SEGMENT_GLYPHS[n] : undefined,
      }))}
    />
  )
}

{
  slug === "section-tabs" && (
    <SectionTabs
      sections={SAMPLE.tabs.slice(0, Number(state.count)).map((title) => ({
        slug: sampleSlug(title),
        title,
      }))}
    />
  )
}

{
  slug === "row-exit" && (
    <>
      <ul data-row-list>
        {Array.from({ length: Number(state.rows) }, (_, i) => (
          <RowExit>
            <span>{SAMPLE.rows[i]}</span>{" "}
            <Button variant="text" size="small" data-row-remove>
              Remove
            </Button>
          </RowExit>
        ))}
      </ul>
      <Button variant="tonal" size="small" data-row-reset>
        Reset
      </Button>
    </>
  )
}

{
  slug === "dialog" && (
    <>
      <Button variant="tonal" data-preview-open={`${id}-dialog`}>
        Open dialog
      </Button>
      <Dialog id={`${id}-dialog`} form={{ method: "dialog" }} aria-labelledby={`${id}-title`}>
        <DialogTitle id={`${id}-title`}>{SAMPLE.dialog.title}</DialogTitle>
        <DialogActions stacked={state.answers === "three"}>
          {state.answers === "three" && (
            <>
              {on("danger") ? (
                <Button variant="text" tone="danger" type="submit">{SAMPLE.danger}</Button>
              ) : (
                <Button variant="filled" type="submit">{SAMPLE.dialog.confirm}</Button>
              )}
              <Button variant="tonal" type="submit">{SAMPLE.dialog.secondary}</Button>
            </>
          )}
          <Button variant="text" type="submit">{SAMPLE.dialog.cancel}</Button>
          {state.answers !== "three" &&
            (on("danger") ? (
              <Button variant="text" tone="danger" type="submit">{SAMPLE.danger}</Button>
            ) : (
              <Button variant="filled" type="submit">{SAMPLE.dialog.confirm}</Button>
            ))}
        </DialogActions>
      </Dialog>
    </>
  )
}

{
  slug === "sheet" && (
    <>
      <Button variant="tonal" data-preview-open={`${id}-sheet`}>
        Open sheet
      </Button>
      <Sheet
        id={`${id}-sheet`}
        title={SAMPLE.sheet}
        titleId={`${id}-sheet-title`}
        close="data-panel-close"
        kind={state.kind === "create" ? "create" : "panel"}
      >
        <Field placeholder={SAMPLE.label} aria-label={SAMPLE.label} />
        <Button variant="filled" data-panel-close>{SAMPLE.dialog.confirm}</Button>
      </Sheet>
    </>
  )
}

{
  slug === "banner" && (
    <Banner
      tone={tone}
      variant={state.variant === "strip" ? "strip" : undefined}
      icon={BANNER_ICON[tone]}
      title={SAMPLE.banner.title}
      body={on("body") ? SAMPLE.banner.body : undefined}
      action={on("action") ? { label: SAMPLE.banner.action, href: "#" } : undefined}
    />
  )
}

{slug === "badge" && <Badge>{state.content === "number" ? "12" : SAMPLE.badge}</Badge>}

{
  slug === "ripple" && (
    <Button variant="tonal" data-ripple>
      {SAMPLE.label}
      <Ripple />
    </Button>
  )
}

{slug === "icon" && <Icon name={state.name as IconName} size={state.size === "lg" ? "lg" : "md"} />}

{slug === "avatar" && <Avatar shape={state.shape} size={state.size as "md" | "lg" | "xl"} />}

{
  slug === "flag" &&
    (state.mode === "text" ? (
      <span>
        <Flag text={`${regionEmoji(state.region ?? "SE")} ${FLAG_NAMES[state.region ?? "SE"]}`} />
      </span>
    ) : (
      <Flag region={state.region} />
    ))
}

{slug === "brand-mark" && <BrandMark />}

{
  slug === "code" && (
    <Code
      client:load
      label={SAMPLE.label}
      text={state.text === "lines" ? SAMPLE.codeLines : SAMPLE.code}
    />
  )
}
