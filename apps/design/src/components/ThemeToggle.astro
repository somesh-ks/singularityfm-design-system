---
import Icon from "@singularity/design-system/Icon";
import IconButton from "@singularity/design-system/IconButton";

/**
 * Light or dark, one press. The glyph shows where a press goes (the sun in the dark theme), and the
 * label says it too. The choice is kept in this browser under the guide's own key and defaults to
 * dark; the reader's saved theme is never touched (themeToggle.ts).
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<IconButton className={className} label="Switch to light theme" data-theme-toggle>
  <Icon name="sun" className="guide-theme-sun" />
  <Icon name="moon" className="guide-theme-moon" />
</IconButton>
<script>
  import "../scripts/themeToggle";
</script>
